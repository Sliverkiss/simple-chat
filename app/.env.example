# Static API key for /v1/* routes. Empty/unset = auth disabled (open access).
# Generate one: openssl rand -hex 24
#DS_API_KEY=

# Redis account store (optional, e.g. Upstash). Unset = accounts.json file
# store (default). Two vars: DS_REDIS_HOST takes the portal URL
# (https://mydb.upstash.io), a bare host (mydb.upstash.io), or a full
# rediss:// connection string (used as-is); DS_REDIS_TOKEN is the Upstash
# token (only needed for URL/host forms). Full records incl. passwords are
# stored, so TLS (rediss://) is required for non-localhost hosts. Seed it
# first: simple-chat -import-redis accounts.json
#DS_REDIS_HOST=https://mydb.upstash.io
#DS_REDIS_TOKEN=
